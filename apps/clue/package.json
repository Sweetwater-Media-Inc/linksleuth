{
  "name": "clue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run build:wasm && vite --host 127.0.0.1",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:contract": "node --test tests/*.test.js",
    "test:browser": "playwright test --project=chromium --project=mobile-chromium",
    "test:cross-browser": "playwright test tests/browser/cross-browser.spec.js --project=firefox --project=webkit",
    "test": "npm run build && npm run test:contract && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "vite": "8.3.7"
  }
}
